# SPDX-License-Identifier: Apache-2.0
#
# Copy to .env and fill in what you need. Every value is optional.
# Names follow the LIVESUBS_* convention; the server reads them from P0-03 on,
# and each feature task documents its own variables here when it lands.

# ── Server ────────────────────────────────────────────────
# LIVESUBS_ADDR=0.0.0.0:8080
# LIVESUBS_DATA_DIR=./data
# LIVESUBS_LOG_FORMAT=text          # text | json
# LIVESUBS_LOG_LEVEL=info           # debug | info | warn | error
# LIVESUBS_PUBLIC_BASE_URL=         # e.g. https://subs.example.com (overrides LAN detection)

# ── Admin ─────────────────────────────────────────────────
# LIVESUBS_ADMIN_TOKEN=             # bearer token for scripted admin access

# ── Secrets ───────────────────────────────────────────────
# Lookup order: env → OS keychain (service "live-subtitles") → encrypted file
# <data dir>/secrets.enc. Secrets set here are read-only in the admin UI.
# The keychain is skipped automatically when none answers (headless Linux, CI);
# admin-UI writes then go to the encrypted file, which needs LIVESUBS_MASTER_KEY.
# LIVESUBS_MASTER_KEY=              # passphrase for the encrypted secrets file (AES-256-GCM, Argon2id)
# GEMINI_API_KEY=                   # secret google_api_key; enables the Gemini provider (GOOGLE_API_KEY also works)
# OBS_WEBSOCKET_PASSWORD=           # secret obs_websocket_password
# LIVESUBS_SECRET_<NAME>=           # any secret by name, upper-cased with non-alphanumerics as _
#                                   # (e.g. LIVESUBS_SECRET_GOOGLE_API_KEY)

# ── Local provider sidecars ───────────────────────────────
# LIVESUBS_WHISPER_URL=http://localhost:8178
# LIVESUBS_OLLAMA_URL=http://localhost:11434
